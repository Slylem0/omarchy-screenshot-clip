#!/bin/bash

# screenshot-clip: screenshots that go to the clipboard only.
#
# Omarchy's Print Screen saves every capture to ~/Pictures, which fills up with
# images that were only ever meant to be pasted. This captures the same way
# (Omarchy's own region picker, so smart/region/window/fullscreen all behave
# identically) but puts the image on the clipboard and keeps just a temporary
# copy under $XDG_RUNTIME_DIR, which lives in RAM and is wiped on reboot.
#
# The copy is handed to the plugin's card in the Omarchy shell (thumbnail with
# Save, Edit and Close). When the shell service is not running, a notification
# takes its place: click it to open the copy in Tensaku.
#
# Usage:
#   screenshot-clip [smart|region|windows|fullscreen]   capture (default smart)
#   screenshot-clip save <file>     copy a temporary screenshot into ~/Pictures
#   screenshot-clip edit <file>     open it in Tensaku (Ctrl+S saves, Enter copies)
#   screenshot-clip copy <file>     put it back on the clipboard
#   screenshot-clip delete <file>   drop the temporary copy
#   screenshot-clip list            temporary copies, newest first
#
# SCREENSHOT_CLIP_KEEP (default 10) sets how many temporary copies are kept;
# SCREENSHOT_CLIP_LANG=es|en forces the language of the fallback notification.

set -o pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
PLUGIN_ID="slylem0.screenshot-clip"
TEMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/screenshot-clip"
KEEP="${SCREENSHOT_CLIP_KEEP:-10}"
[[ $KEEP =~ ^[0-9]+$ ]] && ((KEEP >= 1)) || KEEP=10
NOTIFY_MS=6000

spanish() {
  case "${SCREENSHOT_CLIP_LANG:-auto}" in
  es) return 0 ;;
  en) return 1 ;;
  esac
  [[ ${LC_ALL:-${LC_MESSAGES:-${LANG:-}}} == es* ]]
}

msg() {
  if spanish; then echo "$1"; else echo "$2"; fi
}

# Same folder Omarchy's own screenshots use.
pictures_dir() {
  # shellcheck source=/dev/null
  [[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
  echo "${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
}

# Keep the newest $KEEP temporary copies.
prune() {
  local old
  # shellcheck disable=SC2012 # our own fixed-pattern names, newest first
  old=$(ls -1t "$TEMP_DIR"/screenshot-*.png 2>/dev/null | tail -n +$((KEEP + 1)))
  [[ -n $old ]] && xargs -d '\n' rm -f <<<"$old"
}

# save/copy/delete/edit can be reached over the shell's IPC, so they only ever
# act on a regular file directly inside the temporary folder.
temp_file() {
  local file="$1" dir real
  dir=$(realpath -m -- "$TEMP_DIR")
  real=$(realpath -m -- "$file")
  [[ $(dirname -- "$real") == "$dir" && -f $real && ! -L $file ]] || return 1
  echo "$real"
}

gone() {
  omarchy-notification-send \
    "$(msg "La captura ya no está disponible" "Screenshot no longer available")" \
    "$(msg "Las copias temporales se borran al reiniciar." "Temporary copies are cleared on reboot.")" \
    -t 4000 || true
  exit 1
}

save() {
  local file dir name dest n=2
  file=$(temp_file "$1") || gone
  dir=$(pictures_dir)
  mkdir -p "$dir" || exit 1
  name=$(basename -- "$file" .png)
  dest="$dir/$name.png"
  while [[ -e $dest ]]; do
    dest="$dir/$name-$n.png"
    n=$((n + 1))
  done
  cp -- "$file" "$dest" || exit 1
  echo "$dest"
}

edit() {
  local file dir
  file=$(temp_file "$1") || gone
  dir=$(pictures_dir)
  mkdir -p "$dir"

  # No --save-after-copy: copying from the editor must not write a file.
  exec tensaku \
    --filename "$file" \
    --output-filename "$dir/screenshot-%Y-%m-%d_%H-%M-%S.png" \
    --actions-on-enter save-to-clipboard \
    --copy-command wl-copy \
    --early-exit
}

copy() {
  local file
  file=$(temp_file "$1") || gone
  wl-copy --type image/png <"$file"
}

delete() {
  local file
  file=$(temp_file "$1") || exit 1
  rm -f -- "$file"
}

list() {
  # shellcheck disable=SC2012 # our own fixed-pattern names, newest first
  ls -1t "$TEMP_DIR"/screenshot-*.png 2>/dev/null || true
}

# Cursor handling mirrors omarchy-capture-screenshot: software cursors would be
# baked into the capture, so force hardware cursors until grim has run.
NO_HW_CURSORS=""
FREEZE_PID=""

set_no_hw_cursors() {
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:no_hardware_cursors "$1" &>/dev/null
}

cleanup() {
  [[ -n $FREEZE_PID ]] && kill "$FREEZE_PID" 2>/dev/null
  [[ -n $NO_HW_CURSORS ]] && set_no_hw_cursors "$NO_HW_CURSORS"
}

capture() {
  local mode="${1:-smart}"

  # Pressing Print again while selecting cancels, like the stock screenshot.
  pkill slurp && exit 0

  NO_HW_CURSORS=$(hyprctl getoption cursor:no_hardware_cursors -j | jq '.int')
  trap cleanup EXIT
  set_no_hw_cursors 0

  local selection
  { read -r FREEZE_PID; read -r selection; } < <(omarchy-capture-region "$mode" --keep-freeze)
  [[ -z $selection ]] && exit 0

  mkdir -p "$TEMP_DIR"
  chmod 700 "$TEMP_DIR"
  local file
  file="$TEMP_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"

  grim -g "$selection" "$file" || exit 1
  wl-copy --type image/png <"$file"
  prune

  # The card answers "ok"; anything else means the plugin's service is not
  # loaded, so fall back to a notification whose click opens the editor.
  [[ $(omarchy-shell -q "$PLUGIN_ID" show "$file" 2>/dev/null) == ok ]] && return

  omarchy-notification-send \
    "$(msg "Captura copiada al portapapeles" "Screenshot copied to clipboard")" \
    "$(msg "Clic: editar o guardar · Clic derecho: cerrar" "Click: edit or save · Right-click: close")" \
    --image "$file" \
    -t "$NOTIFY_MS" \
    --exec "$SELF" edit "$file" || true
}

case "${1:-}" in
save | edit | copy | delete)
  [[ -n ${2:-} ]] || {
    echo "Usage: screenshot-clip $1 <file>" >&2
    exit 1
  }
  "$1" "$2"
  ;;
list)
  list
  ;;
-h | --help)
  sed -n '3,24p' "$SELF" | sed 's/^# \{0,1\}//'
  ;;
*)
  capture "$@"
  ;;
esac
